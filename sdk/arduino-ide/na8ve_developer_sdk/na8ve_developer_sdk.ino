/*
 * na8ve_developer_sdk.ino - na8ve-os Developer SDK Barebone Reference Sketch
 *
 * Demonstrates the four on-device C/C++ SDK libraries:
 *   1. Na8veModel : Asynchronous cognitive inference requests
 *   2. Na8veStore : Bounded read-only recall against the three-tier memory graph
 *   3. Na8veAct   : Policy-mediated actuator state proposals
 *   4. Na8veSeam  : Metadata-only sensor telemetry reads
 */

#include <Na8veOS.h>
#include <Na8veModel.h>
#include <Na8veStore.h>
#include <Na8veAct.h>
#include <Na8veSeam.h>

static char g_last_decision[64];
static int32_t g_last_len = 0;
static int32_t g_last_act_rc = -1;
static int64_t g_boot_us = 0;

void setup() {
    g_boot_us = Na8ve.nowUs();
    Serial.println("na8ve-os Developer SDK ready");
}

void onMessage(int32_t from, int32_t op, const uint8_t *buf, int32_t len) {
    (void)from;

    /* Op 1: Standard PING health check */
    if (op == N8_OP_PING) {
        Na8ve.reply("pong na8ve-developer-sdk");
        return;
    }

    /* Op 0x10 (16): Cognitive turn with graph memory recall */
    if (op == 0x10 && len > 0) {
        Na8veRecallResult mem;
        Na8veStore.recall("device state threshold", &mem);

        /* Dispatch prompt asynchronously for neural inference */
        int32_t rc = Na8veModel.request((const char *)buf, (size_t)len, 16);
        if (rc == 0) {
            Na8ve.reply("OK sdk-turn-queued");
        } else if (rc == N8_MODEL_E_SIZE) {
            Na8ve.reply("ERR prompt-too-long");
        } else {
            Na8ve.reply("ERR busy");
        }
        return;
    }

    /* Op 0x11 (17): Retrieve the latest cognitive decision & actuator verdict */
    if (op == 0x11) {
        if (g_last_len > 0) {
            char out[128];
            int at = 0;
            n8_put(out, &at, sizeof(out), "decision=");
            n8_put(out, &at, sizeof(out), g_last_decision);
            n8_put(out, &at, sizeof(out), g_last_act_rc == 0 ? " act=acted" : " act=checked");
            Na8ve.reply(out, (size_t)at);
        } else {
            Na8ve.reply("PENDING");
        }
        return;
    }

    /* Op 0x12 (18): Full 4-subsystem SDK diagnostic self-test */
    if (op == 0x12) {
        Na8veRecallResult mem;
        int32_t hits = Na8veStore.recall("sdk probe", &mem);

        char seam_buf[128] = {0};
        int32_t seam_rc = Na8veSeam.read("device", seam_buf, sizeof(seam_buf));
        bool seam_ok = (seam_rc >= 0 && strstr(seam_buf, "\"reading\":\"none\"") == nullptr);

        char act_verdict[128] = {0};
        int32_t act_rc = Na8veAct.propose("fan", "low", act_verdict, sizeof(act_verdict));
        g_last_act_rc = act_rc;

        int64_t up_ms = (Na8ve.nowUs() - g_boot_us) / 1000;
        if (up_ms < 0) {
            up_ms = 0;
        }

        char report[256];
        int at = 0;
        n8_put(report, &at, sizeof(report), "OK sdk store_hits=");
        n8_put_u(report, &at, sizeof(report), (uint64_t)(hits >= 0 ? hits : 0));
        if (mem.count > 0) {
            n8_put(report, &at, sizeof(report), " score_milli=");
            if (mem.hits[0].score_milli < 0) {
                n8_put(report, &at, sizeof(report), "-");
                n8_put_u(report, &at, sizeof(report), (uint64_t)(-mem.hits[0].score_milli));
            } else {
                n8_put_u(report, &at, sizeof(report), (uint64_t)mem.hits[0].score_milli);
            }
        }
        n8_put(report, &at, sizeof(report), " seam=");
        n8_put(report, &at, sizeof(report), seam_ok ? "ok" : "unavailable");
        n8_put(report, &at, sizeof(report), " act=");
        n8_put(report, &at, sizeof(report), act_verdict[0] ? act_verdict : (act_rc == 0 ? "acted" : "checked"));
        n8_put(report, &at, sizeof(report), " up_ms=");
        n8_put_u(report, &at, sizeof(report), (uint64_t)up_ms);
        Na8ve.reply(report, (size_t)at);
        return;
    }

    Na8ve.reply("ERR op");
}

void onModelReply(const char *text, int32_t len, int32_t err) {
    if (err != 0) {
        Serial.println(err == N8_MODEL_E_RATE ? "na8ve-sdk: rate-limited" : "na8ve-sdk: broker error");
        return;
    }

    /* Sanitize generated bytes to printable ASCII bounded to 48 bytes */
    int32_t k = 0;
    for (int32_t i = 0; i < len && k < 48; i++) {
        char c = text[i];
        if (c >= 32 && c < 127) {
            g_last_decision[k++] = c;
        }
    }
    if (k == 0) {
        memcpy(g_last_decision, "fan=low", 8);
        k = 7;
    } else {
        g_last_decision[k] = '\0';
    }
    g_last_len = k;

    /* Propose policy-mediated actuation through the safety policy table */
    g_last_act_rc = Na8veAct.propose("fan", "low");
    Serial.print("na8ve-sdk decision: ");
    Serial.println(g_last_decision);
}

void loop() {
    /* Triggered explicitly via op 0x10 default path or host polling */
}

